<div class="month-filter-bar">
  <div>
    <p class="eyebrow">Workspace period</p>
    <p class="month-filter-summary"><%= month_filter_label %></p>
    <p class="month-filter-hint">Filters by statement month across pages.</p>
  </div>
  <%= form_with url: month_filter_path, method: :get, class: "month-filter-form", aria: { label: "Filter workspace by month" } do |form| %>
    <%= hidden_field_tag :status, "review" if controller_name.in?(%w[transactions credit_card_transactions]) && params[:status] == "review" %>
    <% if controller_name.in?(%w[transactions credit_card_transactions]) %>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :direction, @direction %>
    <% end %>
    <% if controller_name == "dashboard" %>
      <% @selected_category_ids.each do |category_id| %><%= hidden_field_tag "category_ids[]", category_id, id: nil %><% end %>
    <% end %>
    <%= form.label :month, "Month", for: "workspace-month", class: "sr-only" %>
    <%= form.month_field :month, id: "workspace-month", value: (current_month unless current_month == "all"), class: "input", min: "0001-01", max: "9999-12" %>
    <%= form.submit "Apply", class: "button button-primary" %>
    <%= link_to "All months", month_filter_path + "?" + {
      month: "all",
      status: ("review" if controller_name.in?(%w[transactions credit_card_transactions]) && params[:status] == "review"),
      sort: (@sort if controller_name.in?(%w[transactions credit_card_transactions])),
      direction: (@direction if controller_name.in?(%w[transactions credit_card_transactions])),
      category_ids: (@selected_category_ids if controller_name == "dashboard" && @selected_category_ids.any?)
    }.compact.to_query, class: "quiet-link" %>
  <% end %>
</div>
