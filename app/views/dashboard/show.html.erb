<div class="page-head">
  <div>
    <p class="eyebrow">Overview / <%= month_filter_label %></p>
    <h1>Your money, in focus.</h1>
    <p class="subhead">A clear view of what came in, what went out, and what needs your attention.</p>
  </div>
  <%= link_to new_import_path, class: "button button-primary" do %>＋ Import statement<% end %>
</div>

<div class="kpi-grid mt-10">
  <section class="kpi kpi-featured">
    <p class="eyebrow">Total balance movement</p>
    <strong><%= number_to_currency(@income - @outcome, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
    <span class="kpi-note"><%= month_filter_label %> · after income and outcomes</span>
  </section>
  <section class="kpi">
    <p class="eyebrow">Income</p>
    <strong class="positive">+<%= number_to_currency(@income, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
    <span class="kpi-note"><%= month_filter_label %></span>
  </section>
  <section class="kpi">
    <p class="eyebrow">Outcomes</p>
    <strong><%= number_to_currency(@outcome, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
    <span class="kpi-note"><%= month_filter_label %></span>
  </section>
</div>

<div class="dashboard-grid mt-12">
  <section class="section-panel">
    <div class="section-title">
      <div>
        <p class="eyebrow">12 months through <%= (@month || Date.current).strftime("%B %Y") %></p>
        <h2>Income vs. outcomes</h2>
      </div>
      <%= link_to "View report →", reports_path, class: "quiet-link" %>
    </div>
    <div class="chart" aria-label="Monthly income and outcomes chart">
      <% max = [@monthly_totals.map { |item| [item[:income], item[:outcome]].max }.max, 1].max %>
      <% @monthly_totals.each do |month| %>
        <div class="chart-column">
          <div class="bars">
            <span class="bar income" style="height: <%= (month[:income] / max * 100).round %>%"></span>
            <span class="bar outcome" style="height: <%= (month[:outcome] / max * 100).round %>%"></span>
          </div>
          <small><%= month[:label] %></small>
        </div>
      <% end %>
    </div>
    <div class="legend"><span><i class="dot income"></i> Income</span><span><i class="dot outcome"></i> Outcomes</span></div>
  </section>

  <section class="section-panel">
    <div class="section-title">
      <div><p class="eyebrow">Where it went</p><h2>Outcome categories</h2></div>
      <%= link_to "All categories →", categories_path, class: "quiet-link" %>
    </div>
    <div class="category-list">
      <% @category_totals.first(5).each do |category, rows| %>
        <div class="category-row">
          <span class="category-icon" style="background:<%= category&.color || "#C8C4BC" %>"><%= category&.name.to_s.first(1).upcase %></span>
          <span class="category-name"><%= category&.name || "Uncategorized" %><small><%= rows.size %> <%= "entry".pluralize(rows.size) %></small></span>
          <strong><%= number_to_currency(rows.sum(&:amount), unit: "R$ ", separator: ",", delimiter: ".") %></strong>
        </div>
      <% end %>
      <% if @category_totals.empty? %><p class="empty">Import a statement to see your spending pattern.</p><% end %>
    </div>
  </section>
</div>

<section class="section-panel category-trend-panel mt-8">
  <div class="category-trend-head">
    <div>
      <p class="eyebrow">12-month category trend</p>
      <h2>See what is rising or falling</h2>
      <p class="category-trend-copy">Compare monthly totals for one or more categories. Parent categories include their subcategories.</p>
    </div>
    <%= form_with url: dashboard_path, method: :get, class: "category-trend-filter" do |form| %>
      <%= hidden_field_tag :month, current_month %>
      <details class="category-filter">
        <summary>Choose categories<%= " (#{@selected_category_ids.size})" if @selected_category_ids.any? %></summary>
        <fieldset class="category-filter-panel" aria-describedby="dashboard-category-filter-hint">
          <legend class="sr-only">Categories to compare</legend>
          <p id="dashboard-category-filter-hint">Select one or more categories. Parents include all subcategories.</p>
          <%= hidden_field_tag "category_ids[]", "", id: nil %>
          <div class="category-filter-scroll">
            <%= render "transactions/category_filter_options", categories_by_parent: @filter_categories.group_by(&:parent_id), parent_id: nil, selected_category_ids: @selected_category_ids, field_name: "category_ids[]", id_prefix: "trend-category" %>
            <% if @filter_categories.empty? %><p>No categories available yet.</p><% end %>
          </div>
          <%= form.submit "Compare categories", class: "button button-primary" %>
        </fieldset>
      </details>
      <% if @selected_category_ids.any? %><%= link_to "Clear", dashboard_path(month: current_month, category_ids: [""]), class: "quiet-link" %><% end %>
    <% end %>
  </div>

  <% if @category_trends.any? %>
    <% palette = ["#39825D", "#D97745", "#4676A9", "#9A5FA0", "#B58B22", "#2D8B8A"] %>
    <% chart_series = @category_trends.map { |trend| { name: trend[:category].name, data: trend[:values] } } %>
    <% chart_colors = @category_trends.each_with_index.map { |trend, index| trend[:category].color.presence || palette[index % palette.length] } %>
    <div
      class="category-trend-chart"
      data-controller="category-trend-chart"
      data-category-trend-chart-series-value="<%= chart_series.to_json %>"
      data-category-trend-chart-categories-value="<%= @trend_months.map { |month| month.strftime("%b %Y") }.to_json %>"
      data-category-trend-chart-colors-value="<%= chart_colors.to_json %>"
      aria-label="Monthly totals comparing <%= @category_trends.map { |trend| trend[:category].name }.to_sentence %>">
    </div>
    <table class="sr-only">
      <caption>Monthly category totals</caption>
      <thead><tr><th>Category</th><% @trend_months.each do |month| %><th><%= month.strftime("%B %Y") %></th><% end %></tr></thead>
      <tbody>
        <% @category_trends.each do |trend| %>
          <tr><th><%= trend[:category].name %></th><% trend[:values].each do |value| %><td><%= number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".") %></td><% end %></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="category-trend-empty">
      <span class="empty-icon">↗</span>
      <div><strong>Select categories to reveal their trend.</strong><p>Choose at least one category above to compare monthly totals.</p></div>
    </div>
  <% end %>
</section>

<section class="section-panel mt-8">
  <div class="section-title">
    <div><p class="eyebrow">Needs your eye</p><h2>Categorization queue</h2></div>
    <%= link_to "Review all →", transactions_path(status: :review), class: "quiet-link" %>
  </div>
  <% if @pending.any? %>
    <div class="transaction-list">
      <% @pending.first(4).each do |transaction| %>
        <%= link_to edit_transaction_path(transaction), class: "transaction-row needs-review" do %>
          <span class="transaction-date"><%= transaction.date.strftime("%d %b") %></span>
          <span class="transaction-description"><strong><%= transaction.description %></strong><small><%= transaction.account&.name || "Imported statement" %></small></span>
          <span class="tag">Needs category</span>
          <strong class="amount"><%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
          <span class="arrow">→</span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state"><span class="empty-icon">✓</span><div><strong>All clear for now.</strong><p>New uncategorized entries will appear here after an import.</p></div></div>
  <% end %>
</section>
