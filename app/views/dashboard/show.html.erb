<div class="page-head"><div><p class="eyebrow">Overview / <%= month_filter_label %></p><h1>Your money, in focus.</h1><p class="subhead">A clear view of what came in, what went out, and what needs your attention.</p></div><%= link_to new_import_path, class: "button button-primary" do %>＋ Import statement<% end %></div>
<div class="kpi-grid mt-10">
  <section class="kpi kpi-featured"><p class="eyebrow">Total balance movement</p><strong><%= number_to_currency(@income - @outcome, unit: "R$ ", separator: ",", delimiter: ".") %></strong><span class="kpi-note"><%= month_filter_label %> · after income and outcomes</span></section>
  <section class="kpi"><p class="eyebrow">Income</p><strong class="positive">+<%= number_to_currency(@income, unit: "R$ ", separator: ",", delimiter: ".") %></strong><span class="kpi-note"><%= month_filter_label %></span></section>
  <section class="kpi"><p class="eyebrow">Outcomes</p><strong><%= number_to_currency(@outcome, unit: "R$ ", separator: ",", delimiter: ".") %></strong><span class="kpi-note"><%= month_filter_label %></span></section>
</div>
<div class="dashboard-grid mt-12">
  <section class="section-panel"><div class="section-title"><div><p class="eyebrow">12 months through <%= (@month || Date.current).strftime('%B %Y') %></p><h2>Income vs. outcomes</h2></div><%= link_to "View report →", reports_path, class: "quiet-link" %></div><div class="chart" aria-label="Monthly income and outcomes chart"><% max = [@monthly_totals.map { |m| [m[:income],m[:outcome]].max }.max, 1].max %><% @monthly_totals.each do |month| %><div class="chart-column"><div class="bars"><span class="bar income" style="height: <%= (month[:income] / max * 100).round %>%"></span><span class="bar outcome" style="height: <%= (month[:outcome] / max * 100).round %>%"></span></div><small><%= month[:label] %></small></div><% end %></div><div class="legend"><span><i class="dot income"></i> Income</span><span><i class="dot outcome"></i> Outcomes</span></div></section>
  <section class="section-panel"><div class="section-title"><div><p class="eyebrow">Where it went</p><h2>Outcome categories</h2></div><%= link_to "All categories →", categories_path, class: "quiet-link" %></div><div class="category-list"><% @category_totals.first(5).each do |category, rows| %><div class="category-row"><span class="category-icon" style="background:<%= category&.color || '#C8C4BC' %>"><%= category&.name.to_s.first(1).upcase %></span><span class="category-name"><%= category&.name || 'Uncategorized' %><small><%= rows.size %> <%= "entry".pluralize(rows.size) %></small></span><strong><%= number_to_currency(rows.sum(&:amount), unit: "R$ ", separator: ",", delimiter: ".") %></strong></div><% end %><% if @category_totals.empty? %><p class="empty">Import a statement to see your spending pattern.</p><% end %></div></section>
</div>
<section class="section-panel mt-8"><div class="section-title"><div><p class="eyebrow">Needs your eye</p><h2>Categorization queue</h2></div><%= link_to "Review all →", transactions_path(status: :review), class: "quiet-link" %></div><% if @pending.any? %><div class="transaction-list"><% @pending.first(4).each do |transaction| %><%= link_to edit_transaction_path(transaction), class: "transaction-row needs-review" do %><span class="transaction-date"><%= transaction.date.strftime('%d %b') %></span><span class="transaction-description"><strong><%= transaction.description %></strong><small><%= transaction.account&.name || 'Imported statement' %></small></span><span class="tag">Needs category</span><strong class="amount"><%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong><span class="arrow">→</span><% end %></div><% end %><% else %><div class="empty-state"><span class="empty-icon">✓</span><div><strong>All clear for now.</strong><p>New uncategorized entries will appear here after an import.</p></div></div><% end %></section>
