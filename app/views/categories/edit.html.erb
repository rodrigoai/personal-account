<div class="page-head"><div><p class="eyebrow">Your system / Categories</p><h1>Edit category.</h1></div></div><section class="form-panel narrow mt-10"><%= form_with model: @category, class: "form-stack" do |form| %><% if @category.errors.any? %><div class="form-error"><%= @category.errors.full_messages.to_sentence %></div><% end %><%= form.text_field :name, class: "input" %><%= form.select :kind, Category.kinds.keys.map { |k| [k.humanize, k] }, {}, class: "input" %><%= form.collection_select :parent_id, @available_parents, :id, :name, { include_blank: "Top level" }, class: "input" %><div class="form-actions"><%= link_to "Back", categories_path, class: "quiet-link" %><%= form.submit "Save changes", class: "button button-primary" %></div><% end %></section>
