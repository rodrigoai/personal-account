<div class="page-head"><div><p class="eyebrow">Your system</p><h1>Categories</h1><p class="subhead">Shape the hierarchy that turns raw entries into a useful financial report.</p></div></div><div class="two-column mt-10"><section class="section-panel"><div class="section-title"><div><p class="eyebrow">Category tree</p><h2>Organize your money</h2></div></div><div class="category-tree"><%= render partial: "category", collection: @categories, locals: { depth: 0 } %></div></section><section class="form-panel"><p class="eyebrow">New category</p><h2>Add a branch</h2><%= form_with model: @category, class: "form-stack mt-6" do |form| %><% if @category.errors.any? %><div class="form-error"><%= @category.errors.full_messages.to_sentence %></div><% end %><%= form.text_field :name, placeholder: "Category name", class: "input" %><%= form.select :kind, Category.kinds.keys.map { |k| [k.humanize, k] }, {}, class: "input" %><%= form.collection_select :parent_id, Category.order(:name), :id, :name, { include_blank: "Top level" }, class: "input" %><%= form.submit "Create category", class: "button button-primary w-full" %><% end %></section></div>
