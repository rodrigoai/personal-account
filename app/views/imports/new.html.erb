<div class="page-head"><div><p class="eyebrow">Data room / New import</p><h1>Bring in a Santander statement.</h1><p class="subhead">Current-account spreadsheets and credit-card PDFs are normalized and reconciled without discarding detail rows.</p></div></div>
<section class="form-panel mt-10"><%= form_with model: @import, url: imports_path, class: "form-stack" do |form| %><% if @import.errors.any? %><div class="form-error"><%= @import.errors.full_messages.to_sentence %></div><% end %><div class="form-grid"><div><%= form.label :kind, "Statement type" %><%= form.select :kind, [['Santander current account','bank'],['Santander credit card','credit_card']], {}, class: "input" %></div><div><%= form.label :statement_month, "Statement month" %><%= form.month_field :statement_month, value: Date.current.strftime('%Y-%m'), class: "input" %></div></div><div><%= form.label :account_name, "Account or card name" %><%= form.text_field :account_name, placeholder: "e.g. Santander checking or Santander Mastercard", class: "input" %></div><div class="dropzone"><%= form.file_field :file, accept: '.pdf,.csv,.xls,.xlsx', class: "file-input" %><span class="upload-symbol">↑</span><strong>Drop your Santander statement here</strong><small>PDF, CSV, XLS, or XLSX · max 10MB</small></div><div class="form-actions"><%= link_to "Cancel", imports_path, class: "quiet-link" %><%= form.submit "Upload & continue", class: "button button-primary" %></div><% end %></section>
