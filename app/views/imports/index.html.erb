<div class="page-head"><div><p class="eyebrow">Data room</p><h1>Imports</h1><p class="subhead">Bring in a Santander current-account spreadsheet or credit-card PDF.</p></div><%= link_to new_import_path, class: "button button-primary" do %>＋ New import<% end %></div>
<section class="section-panel mt-10"><div class="section-title"><div><p class="eyebrow">Statement history</p><h2>Recent files</h2></div></div><div class="transaction-list"><% @imports.each do |import| %><%= link_to import_path(import), class: "transaction-row" do %><span class="file-icon"><%= import.kind == 'credit_card' ? 'CC' : 'BK' %></span><span class="transaction-description"><strong><%= import.account_name.presence || import.kind.humanize %></strong><small><%= import.statement_month.strftime('%B %Y') %> · <%= import.file.filename %></small></span><span class="status status-<%= import.status %>"><%= import.status.humanize %></span><span class="arrow">→</span><% end %><% end %><% if @imports.empty? %><div class="empty-state"><span class="empty-icon">↑</span><div><strong>No statements for this period.</strong><p>Choose another month, show all months, or upload a statement.</p></div></div><% end %></div></section>
