<div class="page-head"><div><p class="eyebrow">Categorization</p><h1>Classify this entry.</h1><p class="subhead">Changing the category also updates entries with the exact same description and income/expense direction across all accounts and months of <%= @transaction.statement_month.year %> (statement year). Notes apply only to this entry. Your saved choice is also reused for matching descriptions on future imports.</p></div></div><section class="form-panel narrow mt-10"><div class="review-amount"><span><%= @transaction.date.strftime('%d %B %Y') %></span><strong><%= number_to_currency(@transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong><p><%= @transaction.description %></p></div><%= form_with model: @transaction, class: "form-stack" do |form| %><% if @transaction.errors.any? %><div class="form-error"><%= @transaction.errors.full_messages.to_sentence %></div><% end %><div><%= form.label :category_id, "Selected category" %><%= form.collection_select :category_id, @categories, :id, :name, { include_blank: "Choose a category" }, class: "input" %></div><div><%= form.label :notes, "Note (optional)" %><%= form.text_area :notes, rows: 3, placeholder: "Add context for next time", class: "input" %></div><div class="form-actions"><%= link_to "Back", transactions_path, class: "quiet-link" %><%= form.submit "Save category", class: "button button-primary" %></div><% end %></section>
