<div class="page-head">
  <div>
    <p class="eyebrow">Categorization</p>
    <h1>Classify this entry.</h1>
    <p class="subhead">Changing the category also updates entries with the exact same description and income/expense direction across all accounts and months of <%= @transaction.statement_month.year %> (statement year). The category and note are reused for matching descriptions on future imports.</p>
  </div>
</div>

<section class="form-panel narrow mt-10">
  <div class="review-amount">
    <p class="review-description-label">Transaction</p>
    <div class="review-description-heading">
      <%= link_to google_transaction_search_url(@transaction.description), class: "transaction-google-link review-google-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "Search Google for #{@transaction.description} in São José dos Campos (opens in a new tab)" } do %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg>
      <% end %>
      <h2 class="review-description"><%= @transaction.description %></h2>
    </div>
    <p class="review-date"><strong><%= @transaction.date.strftime("%A") %></strong><span><%= @transaction.date.strftime("%d %B %Y") %></span></p>
    <strong class="review-value"><%= number_to_currency(@transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
  </div>

  <%= form_with model: @transaction, class: "form-stack" do |form| %>
    <% if @transaction.errors.any? %><div class="form-error"><%= @transaction.errors.full_messages.to_sentence %></div><% end %>
    <div><%= form.label :category_id, "Selected category" %><%= form.collection_select :category_id, @categories, :id, :name, { include_blank: "Choose a category" }, class: "input" %></div>
    <div><%= form.label :notes, "Note (optional)" %><%= form.text_area :notes, rows: 3, placeholder: "Add context for next time", class: "input" %></div>
    <div class="form-actions"><%= link_to "Back", @back_path, class: "quiet-link" %><%= form.submit "Save category", class: "button button-primary" %></div>
  <% end %>
</section>
