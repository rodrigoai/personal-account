<div class="page-head">
  <div>
    <p class="eyebrow">Ledger</p>
    <h1><%= @page_title %></h1>
    <p class="subhead"><%= @page_description %></p>
  </div>
</div>

<section class="section-panel mt-10">
  <%= form_with url: @index_path, method: :get, class: "transaction-search", role: "search" do |form| %>
    <%= hidden_field_tag :status, "review" if params[:status] == "review" %>
    <div class="transaction-search-field">
      <%= form.label :q, "Search transactions", for: "transaction-search" %>
      <%= form.search_field :q, id: "transaction-search", value: @query, placeholder: "Description, installment, account, category or notes", maxlength: 200, class: "input" %>
    </div>
    <div class="transaction-sort-field">
      <%= form.label :sort, "Order by" %>
      <%= form.select :sort, [["Date", "date"], ["Name", "name"], ["Value", "value"]], { selected: @sort }, class: "input" %>
    </div>
    <div class="transaction-sort-field">
      <%= form.label :direction, "Direction" %>
      <%= form.select :direction, [["Ascending", "asc"], ["Descending", "desc"]], { selected: @direction }, class: "input" %>
    </div>
    <details class="category-filter">
      <summary>Categories<%= " (#{@selected_category_ids.size})" if @selected_category_ids.any? %></summary>
      <fieldset class="category-filter-panel" aria-describedby="category-filter-hint">
        <legend class="sr-only">Filter transactions by category</legend>
        <p id="category-filter-hint">Select one or more categories. Parents include all subcategories.</p>
        <%= hidden_field_tag "category_ids[]", "", id: nil %>
        <div class="category-filter-scroll">
          <%= render "category_filter_options", categories_by_parent: @filter_categories.group_by(&:parent_id), parent_id: nil %>
          <% if @filter_categories.empty? %><p>No categories available yet.</p><% end %>
        </div>
        <%= form.submit "Apply filters", class: "button button-primary" %>
      </fieldset>
    </details>
    <%= form.submit "Search", class: "button button-primary" %>
    <% if @query.present? %><%= link_to "Clear search", url_for(controller: controller_path, action: :index, q: "", status: params[:status].presence, sort: @sort, direction: @direction), class: "quiet-link" %><% end %>
  <% end %>
  <% if @selected_category_ids.any? %>
    <div class="category-filter-active">
      <p>Categories: <strong><%= @filter_categories.select { |category| @selected_category_ids.include?(category.id) }.map(&:name).to_sentence %></strong></p>
      <%= link_to "Clear categories", url_for(controller: controller_path, action: :index, category_ids: [""], status: params[:status].presence, sort: @sort, direction: @direction), class: "quiet-link" %>
    </div>
  <% end %>
  <div class="filter-row">
    <%= link_to "All entries", url_for(controller: controller_path, action: :index, sort: @sort, direction: @direction), class: (params[:status].blank? ? "filter active" : "filter") %>
    <%= link_to "Needs review", url_for(controller: controller_path, action: :index, status: :review, sort: @sort, direction: @direction), class: (params[:status] == "review" ? "filter active" : "filter") %>
  </div>
  <div class="transaction-list">
    <% if @transactions.empty? %>
      <div class="empty-state"><span class="empty-icon">↗</span><div><strong>No matching transactions.</strong><p>Try another month, change your search or categories, or select All entries.</p></div></div>
    <% end %>
    <% @transactions.each do |transaction| %>
      <div class="transaction-row ledger-transaction-row <%= 'needs-review' if transaction.categorization_pending? %>">
        <div class="transaction-date"><strong><%= transaction.date.strftime("%A") %></strong><time datetime="<%= transaction.date.iso8601 %>"><%= transaction.date.strftime("%d %b %Y") %></time></div>
        <span class="transaction-description">
          <span class="transaction-description-heading">
            <%= link_to google_transaction_search_url(transaction.description), class: "transaction-google-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "Search Google for #{transaction.description} in São José dos Campos (opens in a new tab)" } do %>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg>
            <% end %>
            <strong><%= transaction.description %></strong>
          </span>
          <% if transaction.installment.present? %><small>Installment <%= transaction.installment %></small><% end %>
          <% if transaction.notes.present? %><small><%= transaction.notes %></small><% end %>
        </span>
        <span class="tag"><%= transaction.paid_credit_card_statement ? "card payment" : transaction.direction %></span>
        <strong class="amount"><%= transaction.outcome? ? "-" : "+" %><%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
        <%= link_to edit_transaction_path(transaction), class: "category-button", aria: { label: "Change category for #{transaction.description}" } do %>
          <span class="category-button-dot" style="background:<%= transaction.category&.color || '#D8D6CF' %>"></span>
          <span><%= transaction.category&.name || "Choose category" %></span>
          <small>Change</small>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
